{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "prebuildCommand": "npx expo prebuild --clean",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "1"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "buildConfiguration": "Debug"
      }
    },
    "preview": {
      "distribution": "internal",
      "prebuildCommand": "npx expo prebuild --clean",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "1"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "channel": "production",
      "distribution": "store",
      "prebuildCommand": "npx expo prebuild --clean",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "1",
        "EXPO_PUBLIC_SUPABASE_URL": "REPLACE_WITH_ASANKARY_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "REPLACE_WITH_ASANKARY_SUPABASE_ANON_KEY",
        "EXPO_PUBLIC_FIREBASE_API_KEY": "REPLACE_WITH_ASANKARY_FIREBASE_API_KEY",
        "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "REPLACE_WITH_ASANKARY_FIREBASE_AUTH_DOMAIN",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "REPLACE_WITH_ASANKARY_FIREBASE_PROJECT_ID",
        "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "REPLACE_WITH_ASANKARY_FIREBASE_STORAGE_BUCKET",
        "EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "REPLACE_WITH_ASANKARY_FIREBASE_MESSAGING_SENDER_ID",
        "EXPO_PUBLIC_FIREBASE_APP_ID": "REPLACE_WITH_ASANKARY_FIREBASE_APP_ID",
        "EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID": "",
        "EXPO_PUBLIC_IMGBB_API_KEY": "REPLACE_WITH_ASANKARY_IMGBB_API_KEY",
        "EXPO_PUBLIC_APP_NAME": "Asankary",
        "EXPO_PUBLIC_APP_VERSION": "1.0.0",
        "EXPO_PUBLIC_API_URL": "https://REPLACE_WITH_ASANKARY_API_URL",
        "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": "REPLACE_WITH_ASANKARY_GOOGLE_MAPS_KEY",
        "EXPO_PUBLIC_ENABLE_MAPS": "true",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "REPLACE_WITH_ASANKARY_GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "REPLACE_WITH_ASANKARY_GOOGLE_IOS_CLIENT_ID"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "buildConfiguration": "Release",
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    },
    "preview": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
