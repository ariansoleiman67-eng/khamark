rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============ HELPER FUNCTIONS ============
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Get admin document for the current user
    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Check if current user is a registered admin
    function isRegisteredAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Get the tenantId for the current admin user
    function getAdminTenantId() {
      return getAdminDoc().data.tenantId;
    }
    
    // Check if user is the owner/admin of a specific tenant
    function isAdminOfTenant(tenantId) {
      return isRegisteredAdmin() && getAdminTenantId() == tenantId;
    }
    
    // Check if user is a member of the tenant (owner, admin, or team member)
    function isMemberOfTenant(tenantId) {
      return isAuthenticated() && (
        isAdminOfTenant(tenantId) ||
        exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
      );
    }
    
    // Check if user is from legacy admin system (backwards compatibility)
    function legacyUserDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function legacyUserIsAdmin() {
      return legacyUserDocExists() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
      );
    }

    function isLegacyAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        legacyUserIsAdmin()
      );
    }

    // Helper to find tenantId on an order document safely
    function orderTenantId(resourceData) {
      return resourceData.keys().hasAny(['tenantId']) 
        ? resourceData.tenantId 
        : (resourceData.keys().hasAny(['items']) && resourceData.items.size() > 0 
           ? resourceData.items[0].tenantId 
           : null);
    }
    
    // ============ ADMINS COLLECTION ============
    // Stores admin profiles with their tenantId
    
    match /admins/{uid} {
      // Admins cannot be deleted (for data integrity)
      allow delete: if false;
      // Allow admins to read their own profile, and allow other admins to list admins
      allow read: if request.auth.uid == uid || isLegacyAdmin() || isRegisteredAdmin();
      // Allow users to create their own admin document during signup
      // The uid in the path must match the authenticated user
      allow create: if isAuthenticated() && 
                    request.auth.uid == uid &&
                    request.resource.data.tenantId == uid;
      // Allow admins to update their own profile
      allow update: if isAuthenticated() && request.auth.uid == uid;
    }
    
    // ============ TENANTS COLLECTION ============
    // Root tenant documents
    
    match /tenants/{tenantId} {
      // Public can read tenant info (for contact info, WhatsApp, etc.)
      // This allows customers to get support contact info for orders
      allow read: if true;
      
      // Only the owner (tenantId == uid) can create their tenant
      allow create: if isAuthenticated() && 
                    request.auth.uid == tenantId &&
                    request.resource.data.ownerUid == tenantId;
      
      // Only admins of this tenant can update
      allow update: if isAdminOfTenant(tenantId);
      
      // Tenants cannot be deleted (for data integrity)
      allow delete: if false;
      
      // ============ TENANT-SCOPED COLLECTIONS ============
      
      // PRODUCTS - Admin write, public read for customers
      match /products/{productId} {
        // Anyone can read products (for customer-facing app)
        allow read: if true;
        // Only admins of this tenant can write
        allow write: if isAdminOfTenant(tenantId);
      }
      
      // ORDERS - Admin full access, customers can read their own
      // Orders are created by customers buying products from this tenant
      match /orders/{orderId} {
        // Admins can read all orders, customers can read their own
        allow read: if isAdminOfTenant(tenantId) ||
                    (isAuthenticated() && resource.data.userId == request.auth.uid);
        
        // Any authenticated user can create orders in a tenant collection
        // (customers buying from this tenant's products)
        allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
        
        // Admins can update/delete orders
        // Users can cancel their own orders (update status to 'cancelled' only)
        allow update: if isAdminOfTenant(tenantId) ||
                      (isAuthenticated() && 
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'cancelled' &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancellationReason', 'updatedAt', 'stockStatus', 'stockRolledBackAt']));
        
        allow delete: if isAdminOfTenant(tenantId) || (isAuthenticated() && resource.data.userId == request.auth.uid && resource.data.status == 'cancelled');
      }
      
      // CATEGORIES - Public read, admin write
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdminOfTenant(tenantId);
      }
      
      // CUSTOMERS - Admin only
      match /customers/{customerId} {
        allow read, write: if isAdminOfTenant(tenantId);
      }
      
      // SETTINGS - Members can read, admins can write
      match /settings/{settingId} {
        allow read: if isMemberOfTenant(tenantId) || true; // Public for shipping rates etc.
        allow write: if isAdminOfTenant(tenantId);
      }
      
      // MEMBERS - For multi-admin support
      match /members/{memberId} {
        // Members can read the member list
        allow read: if isMemberOfTenant(tenantId);
        // Only admins can manage members
        allow write: if isAdminOfTenant(tenantId);
      }
      
      // NOTIFICATIONS - Admin only
      match /notifications/{notificationId} {
        allow read: if isMemberOfTenant(tenantId);
        allow write: if isAdminOfTenant(tenantId);
      }
      
      // LOCATIONS - Public read, admin write
      match /locations/{locationId} {
        allow read: if true;
        allow write: if isAdminOfTenant(tenantId);
      }
      
      // PUBLIC STORE PROFILE - Public read, admin write
      // Path: tenants/{tenantId}/public/storeProfile
      // SECURITY: Only storeProfile doc is public, not all docs
      match /public/storeProfile {
        // Anyone can read public store profile (for customer-facing product pages)
        allow read: if true;
        // Only admins of this tenant can write
        allow write: if isAdminOfTenant(tenantId);
      }
      
      // ANALYTICS - Admin only
      match /analytics/{docId} {
        allow read, write: if isAdminOfTenant(tenantId);
      }
      
      // DISCOUNTS - Admin write, public read for active discounts
      match /discounts/{discountId} {
        // Customers can read active discounts to apply them
        allow read: if true;
        // Only admins can create/update/delete discounts
        allow write: if isAdminOfTenant(tenantId);
      }
    }
    
    match /devices/{deviceId} {
      // Allow users to read/write their own device documents
      // We verify ownership via the 'uid' field
      
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      
      allow create: if isAuthenticated() && 
                    request.resource.data.uid == request.auth.uid;
      
      // Allow Update IF:
      // 1. User owns the existing doc (Standard update)
      // 2. OR User is claiming the device (Handover/New Login on used device) - must set uid to self
      allow update: if isAuthenticated() && 
                    request.resource.data.uid == request.auth.uid;
                    
      // Allow Delete IF:
      // 1. User owns the doc
      // 2. OR User is claiming it (to clean up before recreating) - effectively same as update
      allow delete: if isAuthenticated() && 
                    (resource.data.uid == request.auth.uid || true); // Allow cleanup if needed, but 'update' covers takeover. 
                    // Actually, keep delete strict to owner. Takeover should be via 'set' (update/create).
    }

    // ============ GLOBAL COLLECTIONS (For backwards compatibility) ============
    
    // Users collection - for customer accounts (not tenant-specific)
    match /users/{userId} {
      allow get: if true;
      allow list: if false;
      
      allow read: if isAuthenticated() && (isOwner(userId) || isLegacyAdmin() || isRegisteredAdmin());
      
      // Allow create if:
      // 1. User is creating their own document with matching uid, OR
      // 2. User is creating their own document (for push token registration - may not have uid field)
      allow create: if isAuthenticated() && 
                    request.auth.uid == userId;
      
      // Allow update if:
      // 1. User owns the document, OR
      // 2. User is updating their own document by userId match (for merge writes)
      allow update: if isAuthenticated() && isOwner(userId);
      
      allow delete: if isLegacyAdmin() || (isAuthenticated() && isOwner(userId));
      
      // ALIBABA-STYLE: Meta subcollection for notification badge sync
      // Users can read/write their own meta data (badge count, preferences)
      match /meta/{metaId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
      
      // Private subcollection for user-specific private data (shipping info, etc.)
      // Users can only read/write their own private data
      match /private/{docId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // ============ PARTS (PRODUCTS) COLLECTION ============
    // ALIBABA-STYLE: Each product has an ownerAdminId for chat routing
    
    match /parts/{partId} {
      // Public read for customer app
      allow read: if true;
      
      // Create: Admin only
      // 1. Legacy/Owner match
      // 2. Tenant Admin match (must be admin of the tenantId specified in data)
      allow create: if (isLegacyAdmin() || isRegisteredAdmin()) &&
                    (request.resource.data.ownerAdminId == request.auth.uid || 
                     isAdminOfTenant(request.resource.data.tenantId));
      
      // Update: Only owner or tenant admin
      allow update: if isLegacyAdmin() || 
                    (isRegisteredAdmin() && 
                     (resource.data.ownerAdminId == request.auth.uid || isAdminOfTenant(resource.data.tenantId))) ||
                    // Stock update for customers (order placement & cancellation rollback)
                    (isAuthenticated() && 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQty', 'updatedAt', 'variations', 'colorVariations']));
      
      // Delete: Only owner, legacy admin, or tenant admin
      allow delete: if isLegacyAdmin() || 
                    (isRegisteredAdmin() && resource.data.ownerAdminId == request.auth.uid) ||
                    isAdminOfTenant(resource.data.tenantId);
    }
    
    // PRODUCT VARIANTS - For variant/model system
    // Public read for customer app, admin write for variant management
    match /productVariants/{variantId} {
      allow read: if true;
      allow write: if isLegacyAdmin() || isRegisteredAdmin();
    }
    
    // Legacy orders collection - Customer can read their own, admins can update
    match /orders/{orderId} {
      // GET (single doc): Users see own, Admins see if they own the tenant
      allow get: if isAuthenticated() && 
                  (resource.data.userId == request.auth.uid || 
                   isLegacyAdmin() || 
                   (isRegisteredAdmin() && orderTenantId(resource.data) == getAdminTenantId()));

      // LIST (queries): Users can list their own orders, Admins can list all
      allow list: if isAuthenticated() && 
                  (resource.data.userId == request.auth.uid || 
                   isLegacyAdmin() || 
                   (isRegisteredAdmin() && orderTenantId(resource.data) == getAdminTenantId()));

      // CREATE: Users create their own
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // UPDATE: 
      // 1. Legacy Admins
      // 2. Tenant Admins (IF they own the tenant)
      // 3. Users (Cancel only)
      allow update: if isLegacyAdmin() || 
                    (isRegisteredAdmin() && 
                     // MUST match tenantId (either existing or being set)
                     (orderTenantId(resource.data) == getAdminTenantId() || 
                      request.resource.data.tenantId == getAdminTenantId()) &&
                     // Cannot change ownership fields
                     request.resource.data.userId == resource.data.userId &&
                     request.resource.data.items == resource.data.items) || 
                    (isAuthenticated() && resource.data.userId == request.auth.uid && 
                     request.resource.data.status == 'cancelled' &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancellationReason', 'updatedAt', 'stockStatus', 'stockRolledBackAt']));
      
      allow delete: if isLegacyAdmin() || 
                    (isRegisteredAdmin() && orderTenantId(resource.data) == getAdminTenantId()) ||
                    (isAuthenticated() && resource.data.userId == request.auth.uid && resource.data.status == 'cancelled');
    }

    // ============ LIVE TRACKING ============
    match /live_tracking/{orderId} {
      // READ: 
      // - Users who OWN the order
      // - Admins who OWN the tenant of that order
      allow read: if isAuthenticated() && 
                  exists(/databases/$(database)/documents/orders/$(orderId)) &&
                  (get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
                   isLegacyAdmin() ||
                   (isRegisteredAdmin() && orderTenantId(get(/databases/$(database)/documents/orders/$(orderId)).data) == getAdminTenantId()));

      // WRITE: Only Tenant Admin matching the order's tenant
      // Must verify the order belongs to them
      allow write: if isRegisteredAdmin() && 
                   exists(/databases/$(database)/documents/orders/$(orderId)) &&
                   orderTenantId(get(/databases/$(database)/documents/orders/$(orderId)).data) == getAdminTenantId() &&
                   request.resource.data.tenantId == getAdminTenantId();
    }
    
    // Legacy categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isLegacyAdmin();
    }
    
    // Cart - user specific
    match /carts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }
    
    // Addresses - user specific
    match /addresses/{addressId} {
      // Users can query and read their own addresses
      // Allow the read if the document's userId matches auth uid
      // or if user is an admin (legacy or registered)
      allow read: if isAuthenticated() && 
                  (resource.data.userId == request.auth.uid || 
                   isLegacyAdmin() || 
                   isRegisteredAdmin());
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
                           resource.data.userId == request.auth.uid;
    }
    
    // Notifications - user can read their own
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    
    // Settings - public read, admin write
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isLegacyAdmin() || isRegisteredAdmin();
    }
    
    // Locations - public read, admin write
    match /locations/{locationId} {
      allow read: if true;
      allow write: if isRegisteredAdmin() || isLegacyAdmin();
    }
    
    // Store Locations - matched to code usage
    match /store_locations/{locationId} {
      allow read: if true;
      allow write: if isRegisteredAdmin() || isLegacyAdmin();
    }
    
    // Banners - public read, admin write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isRegisteredAdmin() || isLegacyAdmin();
    }
    
    // DISCOUNTS - Admin write, public read for active discounts
    match /discounts/{discountId} {
      // Customers can read active discounts to apply them
      allow read: if true;
      // Only admins can create/update/delete discounts
      allow write: if isAdminOfTenant(request.resource.data.tenantId) || 
                   isAdminOfTenant(resource.data.tenantId);
    }
    
    // ============ APP CONFIG COLLECTION ============
    // Stores app settings like minimum version for force update
    
    match /config/{configId} {
      // Anyone can read config (needed for force update check before auth)
      allow read: if true;
      // Only admins can update config
      allow write: if isRegisteredAdmin() || isLegacyAdmin();
    }
    
    // ============ CONVERSATIONS COLLECTION (Alibaba-style chat) ============
    // Server-only creation via Cloud Functions for security
    
    match /conversations/{conversationId} {
      // Helper: Check if user is a participant (for single doc reads)
      function isParticipant() {
        return request.auth.uid == resource.data.userId || 
               request.auth.uid == resource.data.adminId;
      }
      
      // UDPATE: Allow admins/users to create if they are participants OR if they are admin of the tenant
      allow create: if isAuthenticated() && 
                    (request.resource.data.userId == request.auth.uid || 
                     request.resource.data.adminId == request.auth.uid ||
                     isAdminOfTenant(request.resource.data.tenantId));
      
      // Participants AND Tenant Admins can read their conversations (and check if they exist)
      allow read: if isAuthenticated() && (
        resource == null || 
        isParticipant() || 
        isAdminOfTenant(resource.data.tenantId)
      );
      
      // Allow participants AND Tenant Admins to update (for lastMessage, unread counts)
      allow update: if isAuthenticated() && (isParticipant() || isAdminOfTenant(resource.data.tenantId));
      
      // Both admin and user can delete their own conversations
      allow delete: if isAuthenticated() && (isParticipant() || isAdminOfTenant(resource.data.tenantId));
      
      // ============ MESSAGES SUBCOLLECTION ============
      match /messages/{messageId} {
        // Helper: Check if conversation exists
        function conversationExists() {
          return exists(/databases/$(database)/documents/conversations/$(conversationId));
        }
        
        // Helper: Get parent conversation data
        function getConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        
        // Helper: Check if sender is a participant OR tenant admin
        function isConversationParticipantOrAdmin() {
          let conv = getConversation();
          return request.auth.uid == conv.userId || 
                 request.auth.uid == conv.adminId ||
                 isAdminOfTenant(conv.tenantId);
        }
        
        // Helper: Validate senderType matches actual role
        function validSenderType() {
          let conv = getConversation();
          return (request.resource.data.senderType == 'user' && 
                  request.auth.uid == conv.userId) ||
                 (request.resource.data.senderType == 'admin' && 
                  (request.auth.uid == conv.adminId || isAdminOfTenant(conv.tenantId)));
        }
        
        // Helper: Validate message fields
        function validMessageFields() {
          return request.resource.data.keys().hasOnly(
            ['senderId', 'senderType', 'type', 'text', 'attachmentUrl', 'createdAt', 'fileMetadata', 'senderName']
          ) &&
          request.resource.data.type in ['text', 'image', 'file', 'product', 'voice'] &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time;
        }
        
        // Read: Conversation participants OR Tenant Admins
        allow read: if isAuthenticated() && conversationExists() && isConversationParticipantOrAdmin();
        
        // Create: Must be participant/admin
        allow create: if isAuthenticated() &&
          conversationExists() &&
          isConversationParticipantOrAdmin() &&
          request.resource.data.senderId == request.auth.uid &&
          validSenderType() &&
          validMessageFields();
        
        // Delete: Sender can delete their own messages. Admin can delete any message.
        allow delete: if isAuthenticated() && conversationExists() && (
          isLegacyAdmin() || 
          isRegisteredAdmin() || 
          (isConversationParticipantOrAdmin() && resource.data.senderId == request.auth.uid)
        );
        allow update: if false;
      }
    }
    
    // ============ PHONE TO UID MAPPING ============
    // Server-only mapping (HMAC-SHA256 docId -> internal UID)
    // Client must never read or write directly to prevent enumeration and poisoning.
    match /phoneToUid/{docId} {
      allow read, write: if false;
    }

    // ============ PHONE INDEX COLLECTION ============
    // Maps phone numbers to UIDs for uniqueness
    
    match /phoneIndex/{phoneNumber} {
      // Allow anyone to check if a phone number is already registered
      // This is required for the login/signup flow
      allow read: if true;
      
      // Writes are strictly forbidden from client SDKs
      // Must use linkPhoneIndex Cloud Function
      allow write: if false; 
    }
    
    // ============ DEVICES & PUSH TOKENS ============
    
    match /devices/{deviceId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isLegacyAdmin());
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /pushTokens/{deviceId} {
       allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isLegacyAdmin() || isRegisteredAdmin());
       // Allow create/update if:
       // 1. User is setting their own userId in the document
       // 2. This allows device "takeover" when a new user logs in on a previously used device
       allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
       allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============ DEFAULT DENY ============
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
