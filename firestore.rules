rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy Firestore datastore is fully deprecated and locked down for Khamark.
    // Supabase is the sole authoritative backend datastore.
    // Deny all direct client read and write operations.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
