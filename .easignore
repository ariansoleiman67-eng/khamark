# Controls what `eas build` uploads. When this file exists it REPLACES .gitignore
# for upload filtering — so it must stay a full mirror of .gitignore, not a diff.
#
# Why it exists: google-services.json and GoogleService-Info.plist are git-ignored,
# so EAS never received them. The production profile runs `expo prebuild --clean`,
# and the @react-native-firebase/app config plugin throws when the Google service
# file named in app.config.ts is missing — every cloud build failed during prebuild.
# The two negations at the bottom let EAS see exactly those two files.
#
# Keep every other rule below in sync with .gitignore. Anything you delete here
# gets uploaded to EAS.

# === Dependencies ===
node_modules/
functions/node_modules/

# === Native projects (regenerated by `expo prebuild`) ===
/android
/ios

# === Expo / Metro / build output ===
.expo/
.expo-shared/
dist/
web-build/
output/
tmp/
functions/lib/
*.tsbuildinfo

# === Env & secrets ===
# .env stays excluded on purpose: EAS builds read EXPO_PUBLIC_* from EAS
# environment variables (`eas env:create`), not from an uploaded dotenv file.
.env
.env.*
!.env.example
functions/.env
*.jks
*.keystore
*service*key*
serviceAccountKey.json
.supabase-service-key
credentials.json
credentials/
google-services.json
GoogleService-Info.plist

# === Data dumps / logs ===
*_dump_*.json
firebase_export_*.json
firestore_full_dump_*.json
dump_truckserviceapp-*/
*.log
build_log.txt
clean_log.txt
type-errors.txt

# === OS / editor ===
.DS_Store
*.swp
.idea/
.vscode/

# Supabase local link/temp
supabase/.temp/
.branches
.temp

# Agent scratch. Covered in git by a NESTED .superpowers/sdd/.gitignore, which a
# single root .easignore cannot see — so it has to be named explicitly here.
.superpowers/

# === Firebase client config — needed by the RNFB config plugin at prebuild ===
# These are client-side identifiers (they ship inside every installed app), not
# server secrets. Nothing above this line should ever be negated.
!google-services.json
!GoogleService-Info.plist
