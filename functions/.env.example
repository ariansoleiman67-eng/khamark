# Backend-only secrets for Firebase Functions local development.
# Copy this file to functions/.env and fill in real values locally.
# In production set these via `firebase functions:config` / secrets.

# --- OpenAI (chatbot) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODELS=gpt-4o-mini

# --- SMTP credentials for admin email verification ---
SMTP_USER=
SMTP_PASS=

# --- Google Gemini API Key (visual search) ---
GEMINI_API_KEY=
