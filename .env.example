# Asankary — client env. Copy to `.env` and fill real values (see SETUP_CHECKLIST.md).
# EXPO_PUBLIC_* is INLINED INTO THE APP BUNDLE — only client-safe values here.
# `.env` is git-ignored. Server secrets go to Supabase secrets / Firebase config, NOT here.
# The app boots with these unset (falls back to REPLACE_WITH_ASANKARY_* placeholders; network calls fail gracefully).

# ── Supabase (primary backend) ──
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Firebase (phone OTP, FCM push, Cloud Functions) ──
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Optional override; otherwise derived as https://us-central1-<projectId>.cloudfunctions.net
EXPO_PUBLIC_FIREBASE_FUNCTIONS_URL=

# ── Google Maps (client SDK + Static Maps) ──
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_ENABLE_MAPS=true

# ── Google Sign-In OAuth client IDs ──
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── Cloud Functions / API base + ImgBB proxy ──
EXPO_PUBLIC_API_URL=
# WARNING: EXPO_PUBLIC exposes this to the client — prefer the Cloud Function proxy in production.
EXPO_PUBLIC_IMGBB_API_KEY=

# ── App metadata ──
EXPO_PUBLIC_APP_NAME=Asankary
EXPO_PUBLIC_APP_VERSION=1.0.0

# ── Server-only (do NOT prefix EXPO_PUBLIC; set via Supabase/Firebase secrets in prod) ──
QI_PAYMENT_API_KEY=
FIB_PAYMENT_API_KEY=

# ── Placeholder: domain not yet decided → ASANKARY_DOMAIN_TBD in code ──
