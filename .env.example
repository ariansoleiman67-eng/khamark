# Khamark — Client Environment Template
# Copy this file to `.env` and fill with your Khamark credentials.
# EXPO_PUBLIC_* variables are inlined into the client bundle at build time.
# NEVER put the Supabase service_role key here.

# ── Supabase (Primary Backend for Khamark) ──
EXPO_PUBLIC_SUPABASE_URL=https://your-khamark-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-khamark-anon-public-key

# ── App Metadata ──
EXPO_PUBLIC_APP_NAME=Khamark
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_DEFAULT_TENANT_ID=

# ── Google Maps (Client SDK + Static Maps) ──
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_ENABLE_MAPS=true

# ── Google Sign-In OAuth Client IDs ──
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── Push Notifications & Firebase (FCM) ──
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Verification & Redirects ──
EXPO_PUBLIC_EMAIL_VERIFY_REDIRECT_URL=https://khamark.com/auth/verify

# ── Payment Gateways (Optional) ──
EXPO_PUBLIC_QI_CARD_ENABLED=false
QI_PAYMENT_API_KEY=
FIB_PAYMENT_API_KEY=
