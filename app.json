{
  "expo": {
    "name": "Khamark",
    "slug": "khamark",
    "scheme": "khamark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#A61920",
    "description": "Shop consumer electronics and mobile accessories with fast delivery across Iraq. Browse thousands of products in our online store.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#A61920"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#A61920"
    },
    "assetBundlePatterns": [
      "assets/images/**",
      "assets/icons/**",
      "assets/categories/**",
      "assets/category-icons/**",
      "assets/flags/**",
      "assets/fonts/**",
      "assets/*.png",
      "assets/*.jpg"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.khamark.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Khamark uses your location to fill in your delivery address and to show you the nearest shop branch — for example, dropping a pin on your street so a delivery rider can find you.",
        "NSCameraUsageDescription": "Khamark uses the camera so you can photograph a phone you want to trade in, or take a profile picture.",
        "NSPhotoLibraryUsageDescription": "Khamark uses your photo library so you can attach existing photos to a trade-in request, a message to the shop, or your profile.",
        "NSMicrophoneUsageDescription": "Khamark uses the microphone so you can send the shop a voice message in chat instead of typing.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": ""
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.khamark.app",
      "versionCode": 1,
      "versionName": "1.0",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#A61920"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "INTERNET",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "metaData": [
        {
          "name": "com.google.firebase.messaging.default_notification_channel_id",
          "value": "default_v1"
        }
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "khamark.com",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "www.khamark.com",
              "pathPrefix": "/product"
            },
            {
              "scheme": "khamark"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/auth",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.697952713775-placeholder"
        }
      ],
      "./plugins/withFmtFix.js"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
