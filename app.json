{
  "expo": {
    "name": "Asankary",
    "slug": "Asankary",
    "scheme": "asankary",
    "version": "1.9.43",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#1a365d",
    "description": "Shop consumer electronics and accessories with fast delivery across Iraq. Browse thousands of products in our online store.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#1a365d"
    },
    "assetBundlePatterns": [
      "assets/images/**",
      "assets/icons/**",
      "assets/categories/**",
      "assets/category-icons/**",
      "assets/flags/**",
      "assets/fonts/**",
      "assets/video/intro.mp4",
      "assets/video/intro-poster.jpg",
      "assets/*.png",
      "assets/*.jpg"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asankary.app",
      "buildNumber": "73",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs location access to provide accurate delivery addresses and find nearby parts.",
        "NSCameraUsageDescription": "This app needs camera access to take photos for profile and support tickets.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to select images for profile and support.",
        "NSMicrophoneUsageDescription": "This app needs microphone access for sending voice messages in chat.",
        "NSUserTrackingUsageDescription": "This identifier is used to measure the performance of our ads so we can show you more relevant offers.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBL_OHmMpUcYjgxok8ldXyBWISodVCyAFU"
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.asankary.app",
      "versionCode": 134,
      "versionName": "1.9.43",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "INTERNET",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBL_OHmMpUcYjgxok8ldXyBWISodVCyAFU"
        }
      },
      "metaData": [
        {
          "name": "com.google.firebase.messaging.default_notification_channel_id",
          "value": "default_v1"
        }
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ASANKARY_DOMAIN_TBD",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "www.ASANKARY_DOMAIN_TBD",
              "pathPrefix": "/product"
            },
            {
              "scheme": "asankary"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/auth",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.22285264318-9ipslo5beas3b4l0a2c969eq1fqnnk2j"
        }
      ],
      "./plugins/withFmtFix.js"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
